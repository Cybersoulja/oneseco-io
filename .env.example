# Copy this file to .env and fill in real values. Never commit .env itself.

# Outgoing: the n8n webhook URL this app calls to trigger your workflow.
# e.g. http://sandbox-api.n8n.orb.local/webhook/your-webhook-id
N8N_WEBHOOK_URL=

# Incoming: a shared secret n8n must send back so /api/webhooks/n8n
# knows the request really came from your n8n workflow.
N8N_WEBHOOK_SECRET=
